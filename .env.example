# Set these in Vercel Project Settings -> Environment Variables, then redeploy.
# Provider secret remains on the server; never paste it into the frontend.
IONQ_API_KEY=
# Use a random value at least 32 characters long. Signs portfolio receipts server-side;
# also protects the separate manual connector for authorized runners.
ALMOND_EXECUTION_TOKEN=
# Portfolio optimization always forces the free ideal simulator.
# The separate manual connector uses a cloud simulator by default. Hardware requires both settings below to be changed.
IONQ_BACKEND=simulator
ALMOND_ALLOW_QPU=false

# X API bearer token with recent-search access; provider secret stays server-side.
X_BEARER_TOKEN=
# Optional private read-access guard: use an independent random workspace code.
X_FEED_ACCESS_TOKEN=
# Optional comma-separated X usernames to restrict source accounts (up to 20).
X_FEED_ACCOUNTS=
